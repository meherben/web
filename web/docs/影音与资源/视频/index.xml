s"&gt;&lt;/script&gt;&#13;&#10; &lt;div id="player1"&gt;&lt;/div&gt;&#13;&#10; &lt;script&gt;&#13;&#10; var url='https://resources.avatarmeherbaba.org.cn/video'&#13;&#10; var vodNum=''&#13;&#10; var dp = new DPlayer({&#13;&#10; element: document.getElementById('player1'),&#13;&#10; video: {&#13;&#10; url: url+""+'/1932年美赫巴巴授予好莱坞的讯息.mp4',&#13;&#10; type:'mp4'&#13;&#10; }&#13;&#10; });&#13;&#10; dp.play();&#13;&#10; &lt;/script&gt;&#13;&#10;&lt;p&gt;1932年美赫巴巴旅行至美国，曾到加州的好莱坞逗留一周。巴巴在此授述了电影在影响人们思想和促进人们灵性提升方面，拥有巨大潜能的讯息。他也谈到经济大萧条，解释电影如何在经济萧条方面给予帮助，并给电影从业者们提供了影视创作指导。&lt;/p&gt;</description></item><item><title>至爱</title><link>https://avatarmeherbaba2026.cyou/docs/%E5%BD%B1%E9%9F%B3%E4%B8%8E%E8%B5%84%E6%BA%90/%E8%A7%86%E9%A2%91/shipin-21/</link><pubDate>Fri, 10 Oct 2025 08:17:58 +0800</pubDate><guid>https://avatarmeherbaba2026.cyou/docs/%E5%BD%B1%E9%9F%B3%E4%B8%8E%E8%B5%84%E6%BA%90/%E8%A7%86%E9%A2%91/shipin-21/</guid><description>&lt;link rel="stylesheet" href="https://resources.avatarmeherbaba.org.cn/lib/DPlayer.min.css"&gt;&#13;&#10; &lt;script src="https://resources.avatarmeherbaba.org.cn/lib/jquery.min.js"&gt;&lt;/script&gt;&#13;&#10; &lt;script src="https://resources.avatarmeherbaba.org.cn/lib/hls.min.js"&gt;&lt;/script&gt;&#13;&#10; &lt;script src="https://resources.avatarmeherbaba.org.cn/lib/DPlayer.min.js"&gt;&lt;/script&gt;&#13;&#10; &lt;div id="player1"&gt;&lt;/div&gt;&#13;&#10; &lt;script&gt;&#13;&#10; var url='https://resources.avatarmeherbaba.org.cn/video'&#13;&#10; var vodNum='/002'&#13;&#10; var dp = new DPlayer({&#13;&#10; element: document.getElementById('player1'),&#13;&#10; video: {&#13;&#10; url: url+"/至爱.mp4",&#13;&#10; type:'mp4'&#13;&#10; }&#13;&#10; });&#13;&#10; dp.play();&#13;&#10; &lt;/script&gt;</description></item><item><title>七个真实</title><link>https://avatarmeherbaba2026.cyou/docs/%E5%BD%B1%E9%9F%B3%E4%B8%8E%E8%B5%84%E6%BA%90/%E8%A7%86%E9%A2%91/shipin-22/</link><pubDate>Mon, 13 Oct 2025 18:29:01 +0800</pubDate><guid>https://avatarmeherbaba2026.cyo